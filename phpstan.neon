includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/
    level: 2
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#Access to an undefined property App\\Models\\[a-zA-Z0-9_]+::\$[a-zA-Z0-9_]+#'
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::\$[a-zA-Z0-9_]+#'
        - '#Called .pluck. on Laravel collection, but could have been retrieved as a query#'
