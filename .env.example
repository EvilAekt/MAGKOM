# Application Configuration
APP_NAME=MAGKOM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magkom_db
DB_USERNAME=root
DB_PASSWORD=

# Session & Cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=database

# Mail Configuration
# Pilihan driver: log (default local dev), smtp (Gmail/Mailpit/Mailtrap)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@diskominfo.go.id"
MAIL_FROM_NAME="MAGKOM - Diskominfo"

# Contoh Konfigurasi Gmail SMTP (Google Workspace / Gmail):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=email-anda@gmail.com
# MAIL_PASSWORD=app-password-16-digit-dari-google-account
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="email-anda@gmail.com"
# MAIL_FROM_NAME="MAGKOM Diskominfo"

# Frontend / Vite
VITE_APP_NAME="${APP_NAME}"

# External Services (Placeholders - do not put secrets in repository)
# SENTRY_LARAVEL_DSN=
# GITHUB_PERSONAL_ACCESS_TOKEN=
# BRAVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Realtime SSE Notification (Set false jika dev server Laragon/Windows terasa berat)
REALTIME_SSE_ENABLED=true

# Captcha Security Verification
CAPTCHA_ENABLED=true

# Reverse Proxy & Cloudflare / Load Balancer Configuration
# Kosongkan atau abaikan jika aplikasi berjalan langsung tanpa reverse proxy.
# Gunakan '*' untuk mempercayai semua proxy (misalnya di belakang Cloudflare/AWS ALB),
# atau sebutkan daftar IP / CIDR dipisahkan koma (mis. 127.0.0.1,10.0.0.0/8).
TRUSTED_PROXIES=

# Database Seeder Configuration (Khusus Akun SuperAdmin Awal)
# PENTING: SEED_SUPERADMIN_PASSWORD wajib diisi pada environment production sebelum menjalankan migrasi/seeder.
# Seeder akun pengujian/demo otomatis dicegah berjalan di environment production.
SEED_SUPERADMIN_NAME="Super Administrator"
SEED_SUPERADMIN_EMAIL="superadmin@magkom.go.id"
# SEED_SUPERADMIN_PASSWORD=kata_sandi_kuat_superadmin_minimal_12_karakter

