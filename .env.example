# Application Configuration (SEC-001: Secure-by-Default)
APP_NAME=MAGKOM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://magkom.diskominfo.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Logging (OPS-002)
# Production disarankan: LOG_CHANNEL=stack, LOG_STACK=daily, LOG_LEVEL=warning, LOG_DAILY_DAYS=14
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Database Configuration (Gunakan user non-root dengan hak akses terbatas ke DB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magkom_db
DB_USERNAME=magkom_app
DB_PASSWORD=Ganti_Dengan_Password_Database_Kuat

# Session & Security Cookie (SEC-001)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# Driver Cache Laravel 10 (CACHE_DRIVER) & forward-compatibility Laravel 11 (CACHE_STORE)
CACHE_DRIVER=database
CACHE_STORE=database
CACHE_PREFIX=

# Antrean Pekerjaan (Queue) - Tabel 'jobs' & 'job_batches' tersedia via migrasi
QUEUE_CONNECTION=database

# Mail Configuration (OPS-001)
# Lingkungan Lokal (Dev): gunakan 'log' (catat ke storage/logs) atau 'smtp' dengan Mailpit/Mailtrap
# Lingkungan Production: WAJIB gunakan 'smtp' (Relay Diskominfo / Mailgun / SES). Dilarang 'log'.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@diskominfo.go.id"
MAIL_FROM_NAME="MAGKOM - Diskominfo"

# Contoh Konfigurasi SMTP Production (Pilih salah satu sesuai infrastruktur dinas):
# 1. SMTP Relay Internal Pemerintah Daerah / Diskominfo (Rekomendasi Utama):
# MAIL_MAILER=smtp
# MAIL_HOST=mail-relay.diskominfo.go.id
# MAIL_PORT=25 (atau 587 dengan TLS)
# MAIL_USERNAME=notifikasi.magkom@diskominfo.go.id
# MAIL_PASSWORD=kredensial_resmi_smtp
# MAIL_ENCRYPTION=tls
#
# 2. Transactional Mail Service (Mailgun / AWS SES / Brevo):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailgun.org
# MAIL_PORT=587
# MAIL_USERNAME=postmaster@mg.diskominfo.go.id
# MAIL_PASSWORD=api_smtp_key_resmi
# MAIL_ENCRYPTION=tls
#
# 3. Google Workspace Institusi (Jika menggunakan akun kedinasan Google):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=notifikasi.magkom@diskominfo.go.id
# MAIL_PASSWORD=16_digit_google_workspace_app_password
# MAIL_ENCRYPTION=tls

# Frontend / Vite
VITE_APP_NAME="${APP_NAME}"

# External Services (Placeholders - do not put secrets in repository)
# SENTRY_LARAVEL_DSN=
# GITHUB_PERSONAL_ACCESS_TOKEN=
# BRAVE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Realtime Notification (Gunakan true untuk SSE streaming, atau false di server berkapasitas rendah untuk hemat worker PHP-FPM dengan fallback polling)
REALTIME_SSE_ENABLED=false
REALTIME_POLLING_INTERVAL=15

# Captcha & Bot Protection (SEC-002: Cloudflare Turnstile Server-Side)
# Set true HANYA jika TURNSTILE_SITE_KEY dan TURNSTILE_SECRET_KEY telah diisi lengkap
CAPTCHA_ENABLED=true
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Antivirus & Upload Malware Scanning (UPLOAD-001)
# Driver: 'clamscan', 'daemon' (clamd socket), or 'heuristic'
ANTIVIRUS_ENABLED=true
ANTIVIRUS_DRIVER=clamscan
ANTIVIRUS_REQUIRED=false

# Dedicated Encrypted Backup & Offsite Storage (BACKUP-001, BACKUP-002, BACKUP-003)
# BACKUP_ENCRYPTION_KEY WAJIB berupa key mandiri 32-karakter acak, DILARANG sama dengan APP_KEY.
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_ENCRYPTION_KEY=
BACKUP_KEY_ID=v2-primary
BACKUP_FALLBACK_KEYS=
BACKUP_RETENTION_MAX=30
BACKUP_MIN_FREE_DISK_MB=500
# Pada production, BACKUP_OFFSITE_DISK wajib diisi (misal: 's3')
BACKUP_OFFSITE_DISK=s3

# Reverse Proxy & Cloudflare / Load Balancer Configuration
# Gunakan '*' untuk mempercayai semua proxy (misalnya di belakang Cloudflare/AWS ALB/Nginx Container),
# atau sebutkan daftar IP / CIDR dipisahkan koma (mis. 127.0.0.1,10.0.0.0/8).
TRUSTED_PROXIES=*

# Trusted Hosts (Anti-Host Header Injection)
# Host utama otomatis diambil dari APP_URL beserta seluruh subdomainnya.
# Sebutkan daftar host kustom tambahan dipisahkan koma jika diperlukan (misal: domain-alias.go.id).
TRUSTED_HOSTS=

# Database Seeder Configuration (Khusus Akun SuperAdmin Awal)
# PENTING: SEED_SUPERADMIN_PASSWORD wajib diisi pada environment production sebelum menjalankan migrasi/seeder.
# Seeder akun pengujian/demo otomatis dicegah berjalan di environment production.
SEED_SUPERADMIN_NAME="Super Administrator"
SEED_SUPERADMIN_EMAIL="superadmin@magkom.go.id"
# SEED_SUPERADMIN_PASSWORD=kata_sandi_kuat_superadmin_minimal_12_karakter
SEED_DEMO_ACCOUNTS=false

